1. Table activity, dead tuples, and vacuum

SELECT
    clock_timestamp() AS captured_at,
    schemaname,
    relname,
    n_live_tup,
    n_dead_tup,
    seq_scan,
    seq_tup_read,
    idx_scan,
    n_tup_ins,
    n_tup_upd,
    n_tup_hot_upd,
    n_tup_del,
    last_autovacuum,
    last_autoanalyze,
    autovacuum_count,
    autoanalyze_count
FROM pg_stat_user_tables
WHERE schemaname = 'your_schema'
ORDER BY relname;

2. Index definition, usage and size

SELECT
    clock_timestamp() AS captured_at,
    s.relname AS table_name,
    s.indexrelname AS index_name,
    pg_get_indexdef(s.indexrelid) AS definition,
    s.idx_scan,
    s.idx_tup_read,
    s.idx_tup_fetch,
    pg_size_pretty(pg_relation_size(s.indexrelid)) AS index_size
FROM pg_stat_user_indexes s
WHERE s.schemaname = 'your_schema'
ORDER BY s.relname, s.indexrelname;

3. Table sizes and buffer reads

SELECT
    clock_timestamp() AS captured_at,
    s.relname,
    pg_size_pretty(pg_table_size(s.relid)) AS table_size,
    pg_size_pretty(pg_indexes_size(s.relid)) AS indexes_size,
    s.heap_blks_read,
    s.heap_blks_hit,
    s.idx_blks_read,
    s.idx_blks_hit,
    s.toast_blks_read,
    s.toast_blks_hit
FROM pg_statio_user_tables s
WHERE s.schemaname = 'your_schema'
ORDER BY pg_total_relation_size(s.relid) DESC;

4. Active queries, waits and blockers

WITH schema_sessions AS (
    SELECT DISTINCT l.pid
    FROM pg_locks l
    JOIN pg_class c ON c.oid = l.relation
    JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname = 'your_schema'
      AND l.database = (
          SELECT oid FROM pg_database
          WHERE datname = current_database()
      )
)
SELECT
    clock_timestamp() AS captured_at,
    a.pid,
    a.application_name,
    a.state,
    clock_timestamp() - a.xact_start AS transaction_age,
    CASE WHEN a.state = 'active'
         THEN clock_timestamp() - a.query_start
    END AS query_age,
    a.wait_event_type,
    a.wait_event,
    pg_blocking_pids(a.pid) AS blocking_pids,
    a.query
FROM pg_stat_activity a
JOIN schema_sessions s ON s.pid = a.pid
WHERE a.datname = current_database()
  AND a.pid <> pg_backend_pid()
ORDER BY a.xact_start NULLS LAST;

5. Query execution costs 

SELECT
    clock_timestamp() AS captured_at,
    userid,
    queryid,
    calls,
    total_exec_time,
    mean_exec_time,
    max_exec_time,
    rows,
    shared_blks_hit,
    shared_blks_read,
    shared_blks_dirtied,
    temp_blks_written,
    query
FROM pg_stat_statements
WHERE dbid = (
    SELECT oid FROM pg_database
    WHERE datname = current_database()
)
AND (
    strpos(lower(query), lower('your_schema') || '.') > 0
    OR strpos(lower(query), lower('"your_schema".')) > 0
)
ORDER BY total_exec_time DESC;

6. Postgres version and relevant settings

SELECT version();

SELECT name, setting, unit
FROM pg_settings
WHERE name IN (
    'max_connections',
    'shared_buffers',
    'work_mem',
    'effective_cache_size',
    'track_io_timing',
    'shared_preload_libraries',
    'autovacuum',
    'autovacuum_max_workers',
    'autovacuum_naptime'
)
ORDER BY name;
